# Template file for 'python3-numba'
pkgname=python3-numba
version=0.67.0
revision=1
build_style=python3-pep517
hostmakedepends="python3-build python3-setuptools python3-wheel python3-numpy"
makedepends="python3-devel libgomp-devel"
depends="python3-llvmlite python3-numpy"
checkdepends="python3-pytest python3-numpy python3-llvmlite"
short_desc="NumPy-aware dynamic Python compiler using LLVM"
maintainer="ihateemoji <ihateemoji.dev@gmail.com>"
license="BSD-2-Clause"
homepage="https://numba.pydata.org/"
changelog="https://numba.readthedocs.io/en/stable/release-notes.html"
distfiles="https://github.com/numba/numba/archive/refs/tags/${version}.tar.gz"
checksum=1020d4b8f32487920622f4ad16980911b3f055b63ccb48a92de8e46e03ee10e9

do_build() {
	# Required for the test suite, which imports numba from the source tree.
	python3 setup.py build_ext --inplace

	# Build the package that will actually be installed.
	python3 -m build --wheel --no-isolation
}

do_install() {
	python3 -m installer \
		--destdir="${DESTDIR}" \
		dist/*.whl
}

do_check() {
	python3 -m pytest numba/tests \
		-v \
		--ignore=numba/cuda/tests
}

post_install() {
	vlicense LICENSE
}
